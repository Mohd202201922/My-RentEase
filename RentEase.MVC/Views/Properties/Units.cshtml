@model List<RentEase.MVC.ViewModels.UnitListViewModel>
@{
    ViewData["Title"] = "Units — " + ViewBag.PropertyName;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <a asp-action="Index" class="btn btn-outline-secondary btn-sm me-2">
            <i class="fa fa-arrow-left me-1"></i> Back
        </a>
        <h4 class="d-inline"><i class="fa fa-door-open me-2"></i>@ViewBag.PropertyName</h4>
    </div>
</div>

<!-- Filters -->
<form method="get" class="row g-2 mb-4">
    <input type="hidden" name="propertyId" value="@ViewBag.PropertyId" />
    <div class="col-md-3">
        <select name="unitType" class="form-select">
            <option value="">All Types</option>
            <option value="Apartment" selected="@(ViewBag.UnitType == "Apartment")">Apartment</option>
            <option value="Studio" selected="@(ViewBag.UnitType == "Studio")">Studio</option>
            <option value="Office" selected="@(ViewBag.UnitType == "Office")">Office</option>
            <option value="Shop" selected="@(ViewBag.UnitType == "Shop")">Shop</option>
        </select>
    </div>
    <div class="col-md-3">
        <input type="number" name="maxRent" value="@ViewBag.MaxRent" class="form-control" placeholder="Max rent (BD)" />
    </div>
    <div class="col-md-2">
        <button type="submit" class="btn btn-primary w-100">Filter</button>
    </div>
    <div class="col-md-2">
        <a asp-action="Units" asp-route-propertyId="@ViewBag.PropertyId" class="btn btn-outline-secondary w-100">Clear</a>
    </div>
</form>

<div class="row g-3">
    @foreach (var u in Model)
    {
        var statusColor = u.AvailabilityStatus == "Available" ? "success"
        : u.AvailabilityStatus == "Occupied" ? "danger" : "warning";

        <div class="col-md-4">
            <div class="card h-100 shadow-sm">
                <div class="card-body">
                    <div class="d-flex justify-content-between align-items-start mb-2">
                        <h5 class="card-title mb-0">Unit @u.UnitNumber</h5>
                        <span class="badge bg-@statusColor">@u.AvailabilityStatus</span>
                    </div>
                    <span class="badge bg-secondary mb-2">@u.UnitType</span>
                    <div class="mb-2">
                        <strong class="text-primary">BD @u.MonthlyRent?.ToString("N0") /month</strong>
                    </div>
                    <div class="text-muted small mb-1">
                        <i class="fa fa-ruler me-1"></i>@u.Sizesqm m²
                    </div>
                    @if (!string.IsNullOrEmpty(u.Amenities))
                    {
                        <div class="text-muted small">
                            <i class="fa fa-check-circle me-1"></i>@u.Amenities
                        </div>
                    }
                    @if (u.FeedbackCount > 0)
                    {
                        <div class="mt-2 small text-warning">
                            @for (int i = 1; i <= 5; i++)
                            {
                                <i class="fa@(i <= Math.Round(u.AverageRating) ? "s" : "r") fa-star"></i>
                            }
                            <span class="text-muted ms-1">(@u.FeedbackCount reviews)</span>
                        </div>
                    }
                </div>
                <div class="card-footer d-flex gap-2">
                    @if (u.AvailabilityStatus == "Available" && User.IsInRole("Tenant"))
                    {
                        <a asp-action="UnitDetails" asp-route-id="@u.UnitId"
                           class="btn btn-outline-secondary w-50">
                            <i class="fa fa-info-circle me-1"></i> Details
                        </a>
                        <a asp-controller="LeaseApplications" asp-action="Apply" asp-route-unitId="@u.UnitId"
                           class="btn btn-success w-50">
                            <i class="fa fa-file-alt me-1"></i> Apply
                        </a>
                    }
                    else if (u.AvailabilityStatus == "Available" && User.Identity!.IsAuthenticated && !User.IsInRole("Tenant"))
                    {
                        <a asp-action="UnitDetails" asp-route-id="@u.UnitId"
                           class="btn btn-outline-secondary w-50">
                            <i class="fa fa-info-circle me-1"></i> Details
                        </a>
                        <button class="btn btn-secondary w-50" disabled>
                            <i class="fa fa-lock me-1"></i> Tenants Only
                        </button>
                    }
                    else if (u.AvailabilityStatus == "Available" && !User.Identity!.IsAuthenticated)
                    {
                        <a asp-action="UnitDetails" asp-route-id="@u.UnitId"
                           class="btn btn-outline-secondary w-50">
                            <i class="fa fa-info-circle me-1"></i> Details
                        </a>
                        <a asp-controller="Account" asp-action="Login"
                           class="btn btn-secondary w-50">
                            <i class="fa fa-lock me-1"></i> Login to Apply
                        </a>
                    }
                    else
                    {
                        <a asp-action="UnitDetails" asp-route-id="@u.UnitId"
                           class="btn btn-outline-secondary w-50">
                            <i class="fa fa-info-circle me-1"></i> Details
                        </a>
                        <button class="btn btn-secondary w-50" disabled>
                            <i class="fa fa-ban me-1"></i> Not Available
                        </button>
                    }
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}