@model PropertyViewModel

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0"><i class="fa fa-edit me-2"></i>Edit Property — @Model.Name</h5>
            </div>
            <div class="card-body">
                <form asp-action="Edit" asp-route-id="@Model.PropertyId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="PropertyId" />
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small"></div>

                    <div class="mb-3">
                        <label asp-for="Name" class="form-label"></label>
                        <input asp-for="Name" class="form-control" />
                        <span asp-validation-for="Name" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Description" class="form-label"></label>
                        <textarea asp-for="Description" class="form-control" rows="2"></textarea>
                    </div>

                    <h6 class="mt-3">Location Details</h6>
                    <div class="row g-2 mb-3">
                        <div class="col-4">
                            <label asp-for="BuildingNumber" class="form-label"></label>
                            <input asp-for="BuildingNumber" class="form-control" />
                        </div>
                        <div class="col-4">
                            <label asp-for="Block" class="form-label"></label>
                            <input asp-for="Block" class="form-control" />
                        </div>
                        <div class="col-4">
                            <label asp-for="Street" class="form-label"></label>
                            <input asp-for="Street" class="form-control" />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label asp-for="City" class="form-label"></label>
                            <input asp-for="City" class="form-control" required />
                            <span asp-validation-for="City" class="text-danger small"></span>
                        </div>
                        <div class="col-6">
                            <label asp-for="LocationUrl" class="form-label"></label>
                            <input asp-for="LocationUrl" class="form-control" placeholder="https://maps.google.com/..." />
                        </div>
                    </div>

                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label asp-for="PropertyType" class="form-label"></label>
                            <select asp-for="PropertyType" class="form-select">
                                <option value="">-- Select --</option>
                                <option>Residential</option>
                                <option>Commercial</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label asp-for="ImgPath" class="form-label"></label>
                            <input asp-for="ImgPath" class="form-control" />
                        </div>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-primary">
                            <i class="fa fa-save me-1"></i> Update
                        </button>
                        <a asp-action="Manage" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>