@using RentEase.MVC.ViewModels
@model LeaseApplicationDetailViewModel
@{
    ViewData["Title"] = "Application Details";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fa fa-file-alt me-2"></i>Application #@Model.ApplicationId</h5>
                <span class="badge bg-@(Model.Status == "Approved" ? "success" : Model.Status == "Rejected" ? "danger" : "warning")">
                    @Model.Status
                </span>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h6 class="text-primary">Unit Information</h6>
                        <p><strong>Unit:</strong> @Model.UnitNumber</p>
                        <p><strong>Property:</strong> @Model.PropertyName</p>
                        <p><strong>Address:</strong> @Model.PropertyAddress</p>
                        <p><strong>Monthly Rent:</strong> BD @Model.MonthlyRent.ToString("N2")</p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-primary">Tenant Information</h6>
                        <p><strong>Name:</strong> @Model.TenantName</p>
                        <p><strong>Phone:</strong> @Model.TenantPhone</p>
                        <p><strong>Email:</strong> @Model.TenantEmail</p>
                        <p><strong>Applied:</strong> @Model.CreatedAt.ToString("dd MMM yyyy")</p>
                    </div>
                </div>

                @if (Model.RequestedStartDate.HasValue || Model.RequestedEndDate.HasValue)
                {
                    <div class="mb-4">
                        <h6 class="text-primary">Preferred Dates</h6>
                        <p><strong>Start Date:</strong> @(Model.RequestedStartDate?.ToString("dd MMM yyyy") ?? "Not specified")</p>
                        <p><strong>End Date:</strong> @(Model.RequestedEndDate?.ToString("dd MMM yyyy") ?? "Not specified")</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="mb-4">
                        <h6 class="text-primary">Additional Notes</h6>
                        <p>@Model.Notes</p>
                    </div>
                }

                @if (Model.HasScreening)
                {
                    <div class="alert alert-info">
                        <i class="fa fa-calendar-check me-2"></i>
                        <strong>Screening Status:</strong> @Model.ScreeningStatus
                        @if (Model.ScreeningDate.HasValue)
                        {
                            <br />
                            <strong>Scheduled:</strong>
 
                            @Model.ScreeningDate.Value.ToString("dd MMM yyyy HH:mm")
                        }
                    </div>
                }

                @if (Model.Status == "Screening" && User.IsInRole("Tenant"))
                {
                    <div class="alert alert-warning">
                        <i class="fa fa-clock me-2"></i>
                        Your application is under screening. Please attend the scheduled appointment.
                    </div>
                    @if (Model.HasScreening && (Model.ScreeningStatus == "Pending" || Model.ScreeningStatus == "Confirmed"))
                    {
                        <div class="d-flex gap-2 mb-3">
                            <a asp-controller="Screening" asp-action="Edit" asp-route-id="@Model.ScreeningId" class="btn btn-outline-primary">
                                <i class="fa fa-edit me-1"></i> Edit Appointment
                            </a>
                            <form asp-controller="Screening" asp-action="Cancel" method="post" onsubmit="return confirm('Cancel this screening? Your application will be rejected.');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="screeningId" value="@Model.ScreeningId" />
                                <button type="submit" class="btn btn-outline-danger">
                                    <i class="fa fa-times me-1"></i> Cancel
                                </button>
                            </form>
                        </div>
                    }
                }

                @if (Model.Status == "Screening" && Model.IsPaymentApproved && !Model.PaymentDate.HasValue && User.IsInRole("Tenant"))
                {
                    <div class="alert alert-success">
                        <i class="fa fa-check-circle me-2"></i>
                        Payment approved! Click below to complete your lease.
                    </div>
                    <a asp-action="Pay" asp-route-id="@Model.ApplicationId" class="btn btn-success w-100 mb-3">
                        <i class="fa fa-credit-card me-1"></i> Pay Now
                    </a>
                }

                @if (User.IsInRole("PropertyManager") && Model.Status == "Screening" && Model.HasScreening && Model.ScreeningStatus == "Completed" && !Model.IsPaymentApproved)
                {
                    <form asp-action="ApprovePayment" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="applicationId" value="@Model.ApplicationId" />
                        <button type="submit" class="btn btn-warning w-100 mb-3">
                            <i class="fa fa-check-circle me-1"></i> Approve Payment
                        </button>
                    </form>
                }

                <div class="d-flex gap-2">
                    <a asp-action="Index" class="btn btn-outline-secondary">
                        <i class="fa fa-arrow-left me-1"></i> Back
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>