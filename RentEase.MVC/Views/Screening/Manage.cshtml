@model List<RentEase.MVC.ViewModels.ScreeningListViewModel>
@{
    ViewData["Title"] = "Manage Screenings";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fa fa-calendar-check me-2"></i>Manage Screening Appointments</h2>
</div>

<!-- Status filter -->
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(ViewBag.Status == null ? "active" : "")" asp-action="Manage">All</a>
    </li>
    @foreach (var s in new[] { "Pending", "Confirmed", "Completed", "Cancelled", "Rescheduled" })
    {
        <li class="nav-item">
            <a class="nav-link @(ViewBag.Status == s ? "active" : "")" asp-action="Manage" asp-route-status="@s">@s</a>
        </li>
    }
</ul>

@if (!Model.Any())
{
    <div class="alert alert-info">No screening appointments found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Tenant</th>
                    <th>Unit</th>
                    <th>Property</th>
                    <th>Requested Date</th>
                    <th>Status</th>
                    <th>Requested</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    var statusColor = s.Status switch
                    {
                        "Confirmed" => "success",
                        "Completed" => "info",
                        "Cancelled" => "danger",
                        "Rescheduled" => "warning",
                        _ => "secondary"
                    };
                    <tr>
                        <td>@s.TenantName</td>
                        <td><strong>@s.UnitNumber</strong></td>
                        <td>@s.PropertyName</td>
                        <td>@s.ScheduledDate.ToString("dd MMM yyyy HH:mm")</td>
                        <td><span class="badge bg-@statusColor">@s.Status</span></td>
                        <td>@s.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            <a asp-action="ManageScreening" asp-route-id="@s.ScreeningId" class="btn btn-sm btn-primary">
                                <i class="fa fa-edit"></i> Manage
                            </a>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}