@using RentEase.MVC.ViewModels
@model List<ScreeningListViewModel>
@{
    ViewData["Title"] = "My Screenings";
    var currentStatus = ViewBag.Status as string;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fa fa-calendar-alt me-2"></i>My Screening Appointments</h2>
</div>

<!-- Status filter tabs -->
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(string.IsNullOrEmpty(currentStatus) ? "active" : "")" asp-action="MyScreenings">All</a>
    </li>
    @foreach (var s in new[] { "Pending", "Confirmed", "Completed", "Cancelled", "Rescheduled" })
    {
        <li class="nav-item">
            <a class="nav-link @(currentStatus == s ? "active" : "")" asp-action="MyScreenings" asp-route-status="@s">@s</a>
        </li>
    }
</ul>

@if (!Model.Any())
{
    <div class="alert alert-info">
        <i class="fa fa-info-circle me-2"></i> You don't have any screening appointments yet.
        <a asp-controller="LeaseApplications" asp-action="Index" class="alert-link">Apply for a unit</a> to book a screening.
    </div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>Unit</th>
                    <th>Property</th>
                    <th>Scheduled Date</th>
                    <th>Status</th>
                    <th>Requested</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    var statusColor = s.Status switch
                    {
                        "Confirmed" => "success",
                        "Completed" => "info",
                        "Cancelled" => "danger",
                        "Rescheduled" => "warning",
                        _ => "secondary"
                    };
                    <tr>
                        <td><strong>@s.UnitNumber</strong></td>
                        <td>@s.PropertyName</td>
                        <td>@s.ScheduledDate.ToString("dd MMM yyyy HH:mm") - @s.EndTime.ToString("HH:mm")</td>
                        <td><span class="badge bg-@statusColor">@s.Status</span></td>
                        <td>@s.CreatedAt.ToString("dd MMM yyyy")</td>
                        <td>
                            @if (s.Status == "Pending" || s.Status == "Confirmed")
                            {
                                <a asp-action="Edit" asp-route-id="@s.ScreeningId" class="btn btn-sm btn-outline-primary">
                                    <i class="fa fa-edit"></i> Edit
                                </a>
                                <form asp-action="Cancel" method="post" class="d-inline" onsubmit="return confirm('Cancel this screening?');">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="screeningId" value="@s.ScreeningId" />
                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                        <i class="fa fa-times"></i> Cancel
                                    </button>
                                </form>
                            }
                            else
                            {
                                <button type="button" class="btn btn-sm btn-outline-info" data-bs-toggle="modal" data-bs-target="#notesModal-@s.ScreeningId">
                                    Details
                                </button>
                            }
                        </td>
                    </tr>

                    <!-- Modal for notes -->
                    <div class="modal fade" id="notesModal-@s.ScreeningId" tabindex="-1">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header bg-info text-white">
                                    <h5 class="modal-title">Screening Details - Unit @s.UnitNumber</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                                </div>
                                <div class="modal-body">
                                    <p><strong>Date & Time:</strong> @s.ScheduledDate.ToString("dd MMM yyyy HH:mm")</p>
                                    <p><strong>Status:</strong> <span class="badge bg-@statusColor">@s.Status</span></p>
                                    @if (!string.IsNullOrEmpty(s.Notes))
                                    {
                                        <p><strong>Your Notes:</strong> @s.Notes</p>
                                    }
                                    @if (!string.IsNullOrEmpty(s.ManagerNotes))
                                    {
                                        <p><strong>Manager Notes:</strong> @s.ManagerNotes</p>
                                    }
                                </div>
                                <div class="modal-footer">
                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                                </div>
                            </div>
                        </div>
                    </div>
                }
            </tbody>
        </table>
    </div>
}

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}