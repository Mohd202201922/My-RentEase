@using RentEase.MVC.ViewModels
@model EditScreeningViewModel
@{
    ViewData["Title"] = "Edit Screening";
}

<div class="row justify-content-center">
    <div class="col-md-7">
        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h4 class="mb-0"><i class="fa fa-edit me-2"></i>Edit Screening Appointment</h4>
            </div>
            <div class="card-body">
                <div class="alert alert-info mb-4">
                    <strong>Unit:</strong> @Model.UnitNumber &nbsp;|&nbsp;
                    <strong>Property:</strong> @Model.PropertyName
                </div>

                <form asp-action="Edit" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ScreeningId" />
                    <input type="hidden" asp-for="ApplicationId" />

                    <div class="mb-3">
                        <label asp-for="PreferredDate" class="form-label"></label>
                        <input asp-for="PreferredDate" type="date" class="form-control" min="@DateTime.Now.AddDays(1).ToString("yyyy-MM-dd")" />
                        <span asp-validation-for="PreferredDate" class="text-danger small"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="PreferredTime" class="form-label"></label>
                        <select asp-for="PreferredTime" class="form-select" asp-items="@(new SelectList(Model.AvailableTimeSlots))"></select>
                        <span asp-validation-for="PreferredTime" class="text-danger small"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="Notes" class="form-label"></label>
                        <textarea asp-for="Notes" class="form-control" rows="3"></textarea>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-warning flex-fill">
                            <i class="fa fa-save me-1"></i> Update Request
                        </button>
                        <a asp-action="MyScreenings" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}