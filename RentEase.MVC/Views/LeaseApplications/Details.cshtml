@using RentEase.MVC.ViewModels
@model LeaseApplicationDetailViewModel
@{
    ViewData["Title"] = "Application Details";
}

<div class="row justify-content-center">
    <div class="col-md-8">
        <div class="card shadow-sm">
            <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                <h5 class="mb-0"><i class="fa fa-file-alt me-2"></i>Application #@Model.ApplicationId</h5>
                <span class="badge bg-@(Model.Status == "Approved" ? "success" : Model.Status == "Rejected" ? "danger" : "warning")">
                    @Model.Status
                </span>
            </div>
            <div class="card-body">
                <div class="row mb-4">
                    <div class="col-md-6">
                        <h6 class="text-primary">Unit Information</h6>
                        <p><strong>Unit:</strong> @Model.UnitNumber</p>
                        <p><strong>Property:</strong> @Model.PropertyName</p>
                        <p><strong>Address:</strong> @Model.PropertyAddress</p>
                        <p><strong>Monthly Rent:</strong> BD @Model.MonthlyRent.ToString("N2")</p>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-primary">Tenant Information</h6>
                        <p><strong>Name:</strong> @Model.TenantName</p>
                        <p><strong>Phone:</strong> @Model.TenantPhone</p>
                        <p><strong>Email:</strong> @Model.TenantEmail</p>
                        <p><strong>Applied:</strong> @Model.CreatedAt.ToString("dd MMM yyyy")</p>
                    </div>
                </div>

                @if (Model.RequestedStartDate.HasValue || Model.RequestedEndDate.HasValue)
                {
                    <div class="mb-4">
                        <h6 class="text-primary">Preferred Dates</h6>
                        <p><strong>Start Date:</strong> @(Model.RequestedStartDate?.ToString("dd MMM yyyy") ?? "Not specified")</p>
                        <p><strong>End Date:</strong> @(Model.RequestedEndDate?.ToString("dd MMM yyyy") ?? "Not specified")</p>
                    </div>
                }

                @if (!string.IsNullOrEmpty(Model.Notes))
                {
                    <div class="mb-4">
                        <h6 class="text-primary">Additional Notes</h6>
                        <p>@Model.Notes</p>
                    </div>
                }

                <!-- Manager Actions -->
                @if (User.IsInRole("PropertyManager") && Model.Status == "Pending")
                {
                    if (!Model.IsPaymentApproved)
                    {
                        <form asp-action="PermitPayment" method="post" class="mb-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="applicationId" value="@Model.ApplicationId" />
                            <button type="submit" class="btn btn-warning w-100 mb-2">
                                <i class="fa fa-check-circle me-1"></i> Permit Payment
                            </button>
                        </form>
                        <form asp-action="RejectApplication" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="applicationId" value="@Model.ApplicationId" />
                            <button type="submit" class="btn btn-danger w-100" onclick="return confirm('Reject this application? Unit will become available.')">
                                <i class="fa fa-times-circle me-1"></i> Reject Application
                            </button>
                        </form>
                    }
                    else
                    {
                        <div class="alert alert-success">
                            <i class="fa fa-check-circle me-2"></i> Payment permission granted. The tenant can now proceed to pay.
                        </div>
                        <button class="btn btn-secondary w-100" disabled>
                            <i class="fa fa-lock me-1"></i> Payment Already Permitted
                        </button>
                    }
                }

                @if (User.IsInRole("PropertyManager") && Model.Status == "Approved")
                {
                    <div class="d-flex gap-2 mb-2">
                        <form asp-action="TerminateApplication" method="post" class="flex-fill">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="applicationId" value="@Model.ApplicationId" />
                            <button type="submit" class="btn btn-secondary w-100" onclick="return confirm('Terminate this lease?')">
                                <i class="fa fa-ban me-1"></i> Terminate
                            </button>
                        </form>
                        <form asp-action="RenewApplication" method="post" class="flex-fill">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="applicationId" value="@Model.ApplicationId" />
                            <button type="submit" class="btn btn-primary w-100">
                                <i class="fa fa-sync-alt me-1"></i> Renew
                            </button>
                        </form>
                    </div>
                    @if (Model.TerminationRequested && !Model.TerminationApprovedAt.HasValue)
                    {
                        <form asp-action="ApproveTermination" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="applicationId" value="@Model.ApplicationId" />
                            <button type="submit" class="btn btn-warning w-100" onclick="return confirm('Approve termination? Tenant will have 3 days to vacate.')">
                                <i class="fa fa-check-circle me-1"></i> Approve Termination Request
                            </button>
                        </form>
                    }
                }

                <!-- Tenant Actions -->
                @if (Model.Status == "Pending" && Model.IsPaymentApproved && !Model.PaymentDate.HasValue && User.IsInRole("Tenant"))
                {
                    <div class="alert alert-success mt-3">
                        <i class="fa fa-check-circle me-2"></i>
                        Payment approved! Click below to complete your lease.
                    </div>
                    <a asp-action="Pay" asp-route-id="@Model.ApplicationId" class="btn btn-success w-100 mb-3">
                        <i class="fa fa-credit-card me-1"></i> Pay Now
                    </a>
                }

                @if (Model.Status == "Approved" && User.IsInRole("Tenant") && !Model.TerminationRequested)
                {
                    <form asp-action="RequestTermination" method="post" class="mt-3">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="applicationId" value="@Model.ApplicationId" />
                        <button type="submit" class="btn btn-danger w-100" onclick="return confirm('Request termination? This must be approved by the manager.')">
                            <i class="fa fa-exclamation-triangle me-1"></i> Request Termination
                        </button>
                    </form>
                }
                else if (Model.Status == "Approved" && Model.TerminationRequested)
                {
                    <div class="alert alert-warning mt-3">
                        <i class="fa fa-clock me-2"></i> Termination requested. Awaiting manager approval.
                        @if (Model.TerminationMoveOutDate.HasValue)
                        {
                            <br />
                            <strong>Move‑out date:</strong>
 
                            @Model.TerminationMoveOutDate.Value.ToString("dd MMM yyyy")
                        }
                    </div>
                }

                <!-- Back button -->
                <div class="d-flex gap-2 mt-3">
                    <a asp-action="Index" asp-route-status="@Model.Status" class="btn btn-outline-secondary">
                        <i class="fa fa-arrow-left me-1"></i> Back to @Model.Status List
                    </a>
                </div>
            </div>
        </div>
    </div>
</div>