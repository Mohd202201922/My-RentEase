@model List<RentEase.MVC.ViewModels.LeaseApplicationListViewModel>
@{
    ViewData["Title"] = "Lease Applications";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h2><i class="fa fa-file-alt me-2"></i>Lease Applications</h2>
</div>

<!-- Status filter tabs -->
<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(ViewBag.Status == null ? "active" : "")" asp-action="Index">All</a>
    </li>
    @foreach (var s in new[] { "Screening", "Approved", "Rejected", "Renewal", "Terminated" })
    {
        <li class="nav-item">
            <a class="nav-link @(ViewBag.Status == s ? "active" : "")" asp-action="Index" asp-route-status="@s">@s</a>
        </li>
    }
</ul>

@if (!Model.Any())
{
    <div class="alert alert-info">No applications found.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-hover">
            <thead class="table-dark">
                <tr>
                    <th>#</th>
                    @if (User.IsInRole("PropertyManager"))
                    {
                        <th>Tenant</th>
                    }
                    <th>Unit</th>
                    <th>Property</th>
                    <th>Start Date</th>
                    <th>Status</th>
                    <th>Applied</th>
                    @if (User.IsInRole("PropertyManager"))
                    {
                        <th>Actions</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    var badgeColor = a.Status switch
                    {
                        "Approved" => "success",
                        "Rejected" => "danger",
                        "Screening" => "info",
                        "Renewal" => "primary",
                        "Terminated" => "secondary",
                        _ => "warning"
                    };
                    <tr style="cursor:pointer;" onclick="location.href='@Url.Action("Details", new { id = a.ApplicationId })'">
                        <td class="text-muted small">@a.ApplicationId</td>
                        @if (User.IsInRole("PropertyManager"))
                        {
                            <td>@a.TenantName</td>
                        }
                        <td>@a.UnitNumber</td>
                        <td>@a.PropertyName</td>
                        <td>@(a.RequestedStartDate?.ToString("dd MMM yyyy") ?? "-")</td>
                        <td><span class="badge bg-@badgeColor">@a.Status</span></td>
                        <td>@a.CreatedAt.ToString("dd MMM yyyy")</td>
                        @if (User.IsInRole("PropertyManager"))
                        {
                            <td onclick="event.stopPropagation();">
                                <div class="d-flex gap-1">
                                    @if (a.Status == "Screening")
                                    {
                                        <form asp-action="UpdateStatus" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="applicationId" value="@a.ApplicationId" />
                                            <input type="hidden" name="newStatus" value="Rejected" />
                                            <button class="btn btn-danger btn-sm">Reject</button>
                                        </form>
                                    }
                                    @if (a.Status == "Approved")
                                    {
                                        <form asp-action="UpdateStatus" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="applicationId" value="@a.ApplicationId" />
                                            <input type="hidden" name="newStatus" value="Terminated" />
                                            <button class="btn btn-secondary btn-sm">Terminate</button>
                                        </form>
                                    }
                                    @if (a.Status == "Approved" || a.Status == "Terminated")
                                    {
                                        <form asp-action="UpdateStatus" method="post">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="applicationId" value="@a.ApplicationId" />
                                            <input type="hidden" name="newStatus" value="Renewal" />
                                            <button class="btn btn-primary btn-sm">Renew</button>
                                        </form>
                                    }
                                </div>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    </div>
}